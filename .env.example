# Environment Variables Configuration

# Application
NODE_ENV=development
PORT=4000
APP_PORT=3000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Authentication Mode: 'dev' (User-picker screen) or 'sso' (Azure AD / Entra ID)
AUTH_MODE=dev
JWT_SECRET=cas_digital_platform_secret_key_2026_super_secure_jwt
JWT_EXPIRES_IN=7d

# OpenID Connect / Azure AD (Entra ID) configuration (used when AUTH_MODE=sso)
OIDC_ISSUER=https://login.microsoftonline.com/{tenant-id}/v2.0
OIDC_CLIENT_ID=your-azure-ad-client-id
OIDC_CLIENT_SECRET=your-azure-ad-client-secret
OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/callback

# Database (local SQLite file)
# Path is resolved relative to the apps/api workspace folder.
SQLITE_PATH=./data/cas.db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP Email (MailHog for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CAS Digital Platform <no-reply@adani.com>"

# Storage
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
